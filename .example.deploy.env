# Which instance this is: development, testing, staging or production. `testing` is a public
# instance whose database is reset when a migration calls for it; `staging` is close enough to
# production that it is not. Anything but production says so on the sign-in page, the
# registration page and the home page, and carries a badge in the top bar.
#
# Deliberately empty rather than defaulted: copying this file and forgetting one line must not
# produce a box that calls itself production. The frontend build fails until it is filled in,
# which is the loud direction to fail in — the quiet one tells members their writing is safe
# when it is not.
ENVIRONMENT=""

# The public address of the deployment. Caddy requests a certificate for it, the backend
# allows it as a CORS origin, and it becomes the `servers` entry of the OpenAPI document.
HOST_URL="https://calliope.example.com"

# What this deployment calls itself. Calliope is meant to be run by other communities under
# their own name: this is the name in the browser tab, the wordmark, and the OpenAPI document.
# Leave them out to run as the reference implementation.
#
# Renaming does not reach the logo or the icons — those are the letter C, outlined from
# Newsreader. See `frontend/src/assets/logo/README.md` for how they were produced.
APP_NAME="Calliope"
APP_DESCRIPTION=""

# Omitted from the OpenAPI document entirely when unset, rather than defaulted to somebody.
APP_CONTACT_NAME=""
APP_CONTACT_EMAIL=""

# Only used inside the compose network; the database is not published to the host.
POSTGRES_PASSWORD="change-me"

SMTP_HOST="mail.example.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USERNAME="calliope@example.com"
SMTP_PASSWORD="change-me"

MAIL_FROM_ADDRESS="calliope@example.com"

# Where uploaded files are written. Gitignored in development; a Docker volume in the deployment,
# which is why the two differ.
FILE_STORAGE_PATH="/data/files"
