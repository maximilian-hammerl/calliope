{
  "tasks": {
    "dev": "DENO_TRACE_PERMISSIONS=1 deno run --watch --permission-set=default --env-file=../.env main.ts",
    "run": "DENO_TRACE_PERMISSIONS=1 deno run --permission-set=default --env-file=../.env main.ts",
    "test": "deno test --parallel --permission-set=default --env-file=../.env",
    "format:fix": "deno fmt",
    "format:check": "deno fmt --check",
    "lint:fix": "deno lint --fix",
    "lint:check": "deno lint",
    "type-check": "deno check .",
    "validate:fix": "deno task format:fix && deno task lint:fix && deno task type-check",
    "validate:check": "deno task format:check && deno task lint:check && deno task type-check",
    "db:seed": "deno run --permission-set=default --env-file=../.env seed.ts",
    // Takes <username> <role>, or <username> alone for revoke:
    //   deno task grant-role nachtschreiber administrator
    "grant-role": "deno run --permission-set=default --env-file=../.env main.ts --grant-role",
    "revoke-role": "deno run --permission-set=default --env-file=../.env main.ts --revoke-role",
    "open-api:generate": "deno run --permission-set=default --allow-write --env-file=../.env generate_open_api_spec.ts && deno fmt open-api.json",
    "open-api:check": "deno task open-api:generate && test -z \"$(git status --porcelain open-api.json)\" && echo 'OpenAPI spec is up-to-date' || (echo 'OpenAPI spec is out-of-date, run: deno task open-api:generate' && exit 1)",
    "open-api:lint": "deno x --yes --unstable-detect-cjs npm:@stoplight/spectral-cli lint open-api.json --ruleset .spectral.yaml --fail-severity warn"
  },
  "compilerOptions": {
    "noErrorTruncation": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": [
        "camelcase",
        "default-param-last",
        "eqeqeq",
        "guard-for-in",
        "no-await-in-loop",
        "no-eval",
        "no-implicit-declare-namespace-export",
        "no-node-globals",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-process-global",
        "no-self-compare",
        "no-sparse-arrays",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-useless-rename",
        "single-var-declarator",
        "triple-slash-reference"
        // Left out, each having been tried:
        // "explicit-function-return-type", "explicit-module-boundary-types" — Kysely
        //   builders infer types too large to write and they change with every select.
        // "no-external-import" — flags node:crypto and node:buffer, which no-node-globals'
        //   own --fix adds. No remote URLs here anyway.
        // "no-undef" — 38 false positives on Temporal; deno check covers this properly.
        // "prefer-ascii" — 160 hits, all correct: Calliope is German.
      ]
    }
  },
  // A native addon is loaded from a real node_modules directory, not from Deno's own cache.
  "nodeModulesDir": "auto",
  "unstable": ["cron"],
  "permissions": {
    "default": {
      "env": true,
      // sharp's native addon; see the runtime section of AGENTS.md for what that widens
      "ffi": true,
      "net": true,
      // ioredis
      "read": true,
      // networkInterfaces, hostname for nodemailer; cpus for sharp
      "sys": ["networkInterfaces", "hostname", "cpus"],
      // uploaded files, and nothing else
      "write": ["./.file-storage", "/data/files"]
    }
  },
  "imports": {
    "@/": "./",
    "@hono/structured-logger": "npm:@hono/structured-logger@1.0.0",
    "@hono/zod-openapi": "npm:@hono/zod-openapi@1.6.1",
    "@logtape/logtape": "jsr:@logtape/logtape@2.3.2",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/async": "jsr:@std/async@1.5.0",
    "@std/http": "jsr:@std/http@1.1.3",
    "@std/uuid/v7": "jsr:@std/uuid@1.1.1/v7",
    "sharp": "npm:sharp@0.35.3",
    "@types/nodemailer": "npm:@types/nodemailer@8.0.1",
    "hono": "npm:hono@4.13.3",
    "hono-rate-limiter": "npm:hono-rate-limiter@0.5.3",
    "ioredis": "npm:ioredis@6.0.0",
    "kysely": "npm:kysely@0.29.5",
    "kysely-postgres-js": "npm:kysely-postgres-js@3.0.0",
    "nodemailer": "npm:nodemailer@9.0.5",
    "openapi3-ts": "npm:openapi3-ts@4.6.1",
    "postgres": "npm:postgres@3.4.9",
    "zod": "npm:zod@4.4.3"
  },
  "fmt": {
    "exclude": ["*.md"]
  }
}
