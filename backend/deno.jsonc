{
  "tasks": {
    "dev": "deno serve --watch --permission-set=default --env-file=../.env main.ts",
    "run": "deno serve --permission-set=default --env-file=../.env main.ts",
    "test": "deno test --permission-set=default --env-file=../.env",
    "format:fix": "deno fmt",
    "format:check": "deno fmt --check",
    "lint:fix": "deno lint --fix",
    "lint:check": "deno lint",
    "type-check": "deno check .",
    "validate:fix": "deno task format:fix && deno task lint:fix && deno task type-check",
    "validate:check": "deno task format:check && deno task lint:check && deno task type-check",
    "db:seed": "deno run --permission-set=default --env-file=../.env seed.ts",
    "open-api:generate": "deno run --permission-set=default --allow-write --env-file=../.env generate_open_api_spec.ts && deno fmt open-api.json",
    "open-api:check": "deno task open-api:generate && test -z \"$(git status --porcelain open-api.json)\" && echo 'OpenAPI spec is up-to-date' || (echo 'OpenAPI spec is out-of-date, run: deno task open-api:generate' && exit 1)",
    "open-api:lint": "deno x --yes --unstable-detect-cjs npm:@stoplight/spectral-cli lint open-api.json --ruleset .spectral.yaml --fail-severity warn"
  },
  "unstable": ["cron"],
  "permissions": {
    "default": {
      "env": true,
      "read": true,
      "net": true
    }
  },
  "imports": {
    "@/": "./",
    "@hono/zod-openapi": "npm:@hono/zod-openapi@1.6.0",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/async": "jsr:@std/async@1.5.0",
    "@std/http": "jsr:@std/http@1.1.3",
    "hono": "npm:hono@4.13.2",
    "hono-rate-limiter": "npm:hono-rate-limiter@0.5.3",
    "ioredis": "npm:ioredis@5.11.1",
    "kysely": "npm:kysely@0.29.5",
    "kysely-postgres-js": "npm:kysely-postgres-js@3.0.0",
    "openapi3-ts": "npm:openapi3-ts@4.6.1",
    "postgres": "npm:postgres@3.4.9",
    "zod": "npm:zod@4.4.3"
  },
  "fmt": {
    "exclude": ["*.md"]
  }
}
