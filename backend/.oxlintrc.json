{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import"],
  "env": {
    "node": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    // Beyond the categories: recommended rules they leave out, then the house rules.
    "eslint/no-empty": "error",
    "eslint/no-var": "error",
    "eslint/prefer-const": "error",
    "eslint/require-await": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-explicit-any": "error",
    "eslint/default-param-last": "error",
    "eslint/eqeqeq": "error",
    "eslint/guard-for-in": "error",
    "eslint/no-await-in-loop": "error",
    // `import type` counts too, unlike the default: `query/favourite.ts` imports nothing but types.
    "import/no-cycle": ["error", { "ignoreTypes": false }],
    "eslint/no-eval": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/no-non-null-assertion": "error",
    "eslint/no-self-compare": "error",
    "eslint/no-sparse-arrays": "error",
    "eslint/no-throw-literal": "error",
    "eslint/no-useless-rename": "error",
    "eslint/one-var": ["error", "never"],
    "eslint/require-unicode-regexp": "error",
    "typescript/triple-slash-reference": "error",
    // The server logs through `src/logging.ts`, so every line it writes is JSON.
    "eslint/no-console": "error",
    // A built-in is imported as `node:fs`, so it cannot be mistaken for a package of that name.
    "unicorn/prefer-node-protocol": "error",
    // What it could not: these need the types, which `--type-aware` brings.
    // `node:test` runs a top-level `test()` without anyone awaiting the promise it returns.
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [{ "from": "package", "name": "test", "package": "node:test" }]
      }
    ],
    "typescript/no-misused-promises": "error",
    "typescript/only-throw-error": "error",
    "typescript/switch-exhaustiveness-check": "error",
    // Outside the override below, the casts it finds are deliberate, such as Kysely references in
    // generic helpers, Zod's internals, `Object.keys()` and a test's `response.json()`.
    "typescript/no-unsafe-type-assertion": "off",
    // It refuses the bare `return;` after a middleware's `next()`, which tsc's `noImplicitReturns`
    // demands.
    "typescript/consistent-return": "off",
    // It would move helpers away from their one use, and break up the fixture factories that hand
    // theirs out together.
    "unicorn/consistent-function-scoping": "off",
    // It wants rows mutated in place with `Object.assign`, for lists that are short: a page, a
    // member's sessions, the seed.
    "oxc/no-map-spread": "off"
    // Left out, each having been tried:
    // "explicit-function-return-type", "explicit-module-boundary-types" — Kysely builders infer
    //   types too large to write and they change with every select.
    // "no-undef" — false positives on Temporal; `tsc` covers this properly.
    // `camelcase` and `prefer-ascii` have no oxlint equivalent; the latter had 160 hits, all
    //   correct, since Calliope is German.
  },
  "overrides": [
    {
      // Where a cast to a scoped id would skip its resolver, which `scope.md` forbids.
      "files": ["src/route/**", "src/service/**", "src/middleware/**"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "error"
      }
    },
    {
      // Tests may mint and cast, as `scope.md` allows.
      "files": ["**/*_test.ts"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      // Command-line scripts, whose output is what they print.
      "files": ["grant_role.ts", "seed.ts", "generate_open_api_spec.ts"],
      "rules": {
        "eslint/no-console": "off"
      }
    }
  ]
}
