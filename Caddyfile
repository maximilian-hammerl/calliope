# The site address comes from HOST_URL, so the domain is configured in one place and the
# backend's CORS origin, the OpenAPI `servers` entry and the certificate always agree.
{$HOST_URL} {
	encode zstd gzip

	# Everything the backend serves lives under one prefix, so adding a resource needs no
	# change here and no route can be forgotten.
	handle /api/* {
		reverse_proxy backend:8000 {
			# The chat stream is an endless text/event-stream. Caddy buffers responses by
			# default, which would hold every message until the connection closed — that is,
			# forever. This works locally without it and delivers nothing in production, so it
			# is the one setting here that cannot be verified before deploying.
			flush_interval -1

			# The rate limiter buckets by the first entry of X-Forwarded-For, so this has to
			# replace whatever the client sent rather than append to it. Caddy's default
			# already does, but a limiter that can be side-stepped by a header is not
			# something to leave resting on a default.
			header_up X-Forwarded-For {remote_host}
		}
	}

	# The single page application. Unknown paths fall back to its entry point, so a
	# client-side route survives a reload.
	handle {
		root * /srv

		# The backend sets its own headers through Hono's secureHeaders, which never runs
		# for these static files — without this the document that loads all the JavaScript
		# would be the only unprotected response. Kept in step with that middleware's
		# defaults, plus a policy it does not set.
		header {
			Strict-Transport-Security "max-age=15552000; includeSubDomains"
			X-Content-Type-Options nosniff
			X-Frame-Options SAMEORIGIN
			Referrer-Policy no-referrer
			Cross-Origin-Opener-Policy same-origin
			Cross-Origin-Resource-Policy same-origin

			# `style-src` has to allow inline styles because the dropdown positions itself
			# through the style attribute; scripts stay strict, which is the part that
			# matters. The fonts are served from here, so no third party is named at all.
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		}

		# Everything under /assets carries a content hash in its name — scripts, styles and
		# fonts alike — so a given name can never change meaning and a year is safe. The
		# entry point itself stays uncached, which is what lets a deploy take effect.
		@fingerprinted path /assets/*
		header @fingerprinted Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
