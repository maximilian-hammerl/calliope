# Which instance this is: development, testing, staging or production. Required, with no
# default — an instance that cannot say what it is would claim to be production, and members
# would trust writing to it. The frontend is built with the same value and says so on screen.
ENVIRONMENT="development"

HOST_URL="http://localhost:5173"

# Only needed to run a second checkout beside the first; each defaults to the value shown.
# The frontend proxies `/api` to BACKEND_PORT, so those two move together.
# `.claude/launch.json` needs BACKEND_PORT and FRONTEND_PORT stated again — it cannot read this
# file — so copy `.claude/launch.example.json` and change them there too.
# BACKEND_PORT="8000"
# FRONTEND_PORT="5173"
# POSTGRES_PORT="54322"
# REDIS_PORT="63792"
# MAILPIT_PORT="8025"

DATABASE_URL="postgres://calliope:calliope@localhost:54322/calliope?sslmode=disable"
REDIS_URL="redis://localhost:63792"

# dbmate configuration: https://github.com/amacneil/dbmate?tab=readme-ov-file#command-line-options
DBMATE_MIGRATIONS_TABLE="migration.schema_migration"
DBMATE_STRICT="true"
DBMATE_SCHEMA_FILE="schema.sql"
DBMATE_MIGRATIONS_DIR="./migrations"

SMTP_HOST="localhost"
SMTP_PORT="1025"
# false for Mailpit
SMTP_SECURE="false"
# Empty for Mailpit
SMTP_USERNAME=""
SMTP_PASSWORD=""

MAIL_FROM_ADDRESS="calliope@localhost"

# Where uploaded files are written. Gitignored in development; a Docker volume in the deployment,
# which is why the two differ.
FILE_STORAGE_PATH="./.file-storage"

# Where the breach check asks when a password is chosen. The real service, or a mirror of it.
PWNED_PASSWORDS_URL="https://api.pwnedpasswords.com/range"
