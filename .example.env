# Copy to `.env`. The defaults are what a development checkout wants, and CI copies this file as
# it stands; a deployment changes every line marked „deployment" — see deployment/README.md.
#
# `PUBLIC_` puts a value in the frontend bundle, where anyone can read it. Nothing else gets there.


# ── What this instance is ──

# development, testing, staging or production. Anything but production says so on screen.
# deployment: `deploy.sh --environment` has to name the same one.
PUBLIC_ENVIRONMENT="development"

# deployment: the public address, which Caddy also requests a certificate for.
HOST_URL="http://localhost:5173"

# Stamped by `deploy.sh` from `git describe`, never set by hand; "unknown" without it.
# PUBLIC_GIT_COMMIT=""


# ── Who runs it: the Impressum and the privacy policy ──

# Empty shows obvious placeholders. Postal code and town go together or not at all.
# deployment: the name and the e-mail address are required, and the build refuses without them.
PUBLIC_WEBSITE_OPERATOR_NAME=""
PUBLIC_WEBSITE_OPERATOR_EMAIL_ADDRESS=""
PUBLIC_WEBSITE_OPERATOR_STREET=""
PUBLIC_WEBSITE_OPERATOR_POSTAL_CODE=""
PUBLIC_WEBSITE_OPERATOR_CITY=""
PUBLIC_WEBSITE_OPERATOR_TELEPHONE_NUMBER=""

# Who the site is hosted with. deployment: the name is required, the address optional.
PUBLIC_HOSTER_NAME=""
PUBLIC_HOSTER_STREET=""
PUBLIC_HOSTER_POSTAL_CODE=""
PUBLIC_HOSTER_CITY=""


# ── What it calls itself ──

# Renaming does not reach the logo — see `frontend/src/assets/logo/README.md`.
PUBLIC_APP_NAME="Calliope"
# Where the footer sends somebody who wants the code. Point a fork at *its* own source: the
# licence is AGPL, so a modified instance owes its users the version it is actually running.
PUBLIC_SOURCE_URL="https://github.com/maximilian-hammerl/calliope"
APP_DESCRIPTION=""

# Left out of the OpenAPI document entirely when unset.
APP_CONTACT_NAME=""
APP_CONTACT_EMAIL_ADDRESS=""


# ── Database and cache ──

# Both go unread in a deployment, which builds its own from the password below.
DATABASE_URL="postgres://calliope:calliope@localhost:54322/calliope?sslmode=disable"
REDIS_URL="redis://localhost:63792"

# deployment only, and required there. Development has its own in `docker-compose.yaml`.
POSTGRES_PASSWORD=""


# ── Migrations ──

# dbmate's own, read when `database/` runs it; a deployment's `migrate` service states its own.
# https://github.com/amacneil/dbmate?tab=readme-ov-file#command-line-options
DBMATE_MIGRATIONS_TABLE="migration.schema_migration"
DBMATE_STRICT="true"
DBMATE_SCHEMA_FILE="schema.sql"
DBMATE_MIGRATIONS_DIR="./migrations"


# ── Mail ──

# Mailpit, from `docker-compose.yaml`: no TLS, no credentials, nothing leaves the machine.
# deployment: a real server, port 465 and secure, with credentials the compose file requires.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USERNAME=""
SMTP_PASSWORD=""

# deployment: an address the server above is allowed to send as.
MAIL_FROM_ADDRESS="calliope@localhost"


# ── Files and outside services ──

# Gitignored here. deployment: an absolute path in the container, a volume so uploads outlive it.
FILE_STORAGE_PATH="./.file-storage"

# Where the breach check asks when a password is chosen. The real service, or a mirror of it.
PWNED_PASSWORDS_URL="https://api.pwnedpasswords.com/range"


# ── Ports: only to run a second checkout beside the first ──

# `.claude/launch.json` needs BACKEND_PORT and FRONTEND_PORT again — it cannot read this file,
# so copy `.claude/launch.example.json` and change them there too.
# BACKEND_PORT="8000"
# FRONTEND_PORT="5173"
# POSTGRES_PORT="54322"
# REDIS_PORT="63792"
# MAILPIT_PORT="8025"
