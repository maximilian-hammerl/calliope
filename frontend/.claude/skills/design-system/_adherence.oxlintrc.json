{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/context/**",
              "components/core/**",
              "components/navigation/**",
              "components/thread/**",
              "ui_kits/app_desktop/**",
              "ui_kits/app_mobile/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader|IBM Plex Sans|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Newsreader, IBM Plex Sans, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Avatar> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:label|tag)$/]",
        "message": "<Badge> variant must be one of 'label' | 'tag'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|level|size|block|disabled|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, level, size, block, disabled, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:solid|quiet|outline|plain)$/]",
        "message": "<Button> level must be one of 'solid' | 'quiet' | 'outline' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Composer'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|onSubmit|onPreview|saveState|collapsed|onToggleCollapse|submitting|label|submitLabel|gutter|maxWidth|style|key|ref|className|style|children)$/]",
        "message": "<Composer> doesn't accept that prop. Declared props: value, onChange, onSubmit, onPreview, saveState, collapsed, onToggleCollapse, submitting, label, submitLabel, gutter, maxWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Composer'] > JSXAttribute[name.name='saveState'] > Literal[value!=/^(?:saving|saved|none)$/]",
        "message": "<Composer> saveState must be one of 'saving' | 'saved' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GroupFile'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|type|key|ref|className|style|children)$/]",
        "message": "<GroupFile> doesn't accept that prop. Declared props: name, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='GroupHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|visibility|threadCount|threadLimit|gutter|children|style|key|ref|className|style|children)$/]",
        "message": "<GroupHeader> doesn't accept that prop. Declared props: name, visibility, threadCount, threadLimit, gutter, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GroupHeader'] > JSXAttribute[name.name='visibility'] > Literal[value!=/^(?:Privat|Öffentlich)$/]",
        "message": "<GroupHeader> visibility must be one of 'Privat' | 'Öffentlich'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GroupListItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|unread|key|ref|className|style|children)$/]",
        "message": "<GroupListItem> doesn't accept that prop. Declared props: id, name, unread."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Label> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Member'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|key|ref|className|style|children)$/]",
        "message": "<Member> doesn't accept that prop. Declared props: name, role."
      },
      {
        "selector": "JSXOpeningElement[name.name='Note'] > JSXAttribute > JSXIdentifier[name!=/^(?:author|time|text|key|ref|className|style|children)$/]",
        "message": "<Note> doesn't accept that prop. Declared props: author, time, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='PanelCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<PanelCard> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Post'] > JSXAttribute > JSXIdentifier[name!=/^(?:author|time|edited|bookmarked|children|actions|onAction|notesCount|notesOpen|onToggleNotes|divider|style|key|ref|className|style|children)$/]",
        "message": "<Post> doesn't accept that prop. Declared props: author, time, edited, bookmarked, children, actions, onAction, notesCount, notesOpen, onToggleNotes, divider, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RailToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:side|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<RailToggle> doesn't accept that prop. Declared props: side, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RailToggle'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<RailToggle> side must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|placeholder|width|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: value, onChange, placeholder, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='Step'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|text|author|done|key|ref|className|style|children)$/]",
        "message": "<Step> doesn't accept that prop. Declared props: id, text, author, done."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|strong|key|ref|className|style|children)$/]",
        "message": "<StatusField> doesn't accept that prop. Declared props: label, value, strong."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThreadHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|postCount|lastActivity|lastAuthor|filter|onFilter|style|key|ref|className|style|children)$/]",
        "message": "<ThreadHeader> doesn't accept that prop. Declared props: title, postCount, lastActivity, lastAuthor, filter, onFilter, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThreadTabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|key|ref|className|style|children)$/]",
        "message": "<ThreadTabItem> doesn't accept that prop. Declared props: id, name."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onSelect|user|query|onQueryChange|compact|style|key|ref|className|style|children)$/]",
        "message": "<TopBar> doesn't accept that prop. Declared props: items, active, onSelect, user, query, onQueryChange, compact, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
