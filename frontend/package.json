{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:fix": "oxlint --fix",
    "lint:check": "oxlint",
    "format:fix": "oxfmt",
    "format:check": "oxfmt --check",
    "validate:fix": "npm run format:fix && npm run lint:fix && npm run type-check",
    "validate:check": "npm run format:check && npm run lint:check && npm run type-check",
    "open-api:generate-client": "orval --config ./orval.config.ts && node scripts/generateTextLimit.ts"
  },
  "dependencies": {
    "@lucide/vue": "1.31.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/vue-query": "5.101.4",
    "@vueuse/core": "14.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "reka-ui": "2.10.3",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@types/jsdom": "28.0.3",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "jiti": "2.7.0",
    "jsdom": "29.1.1",
    "npm-run-all2": "9.0.3",
    "orval": "8.24.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.10"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
