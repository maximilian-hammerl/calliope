{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run \"/^(type-check|build-only)$/\"",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:fix": "oxlint --fix",
    "lint:check": "oxlint",
    "format:fix": "oxfmt",
    "format:check": "oxfmt --check",
    "validate:fix": "pnpm run format:fix && pnpm run lint:fix && pnpm run type-check",
    "validate:check": "pnpm run format:check && pnpm run lint:check && pnpm run type-check && pnpm --workspace-root run knip:check",
    "open-api:generate-client": "orval --config ./orval.config.ts && node scripts/generateTextLimit.ts"
  },
  "dependencies": {
    "@lucide/vue": "1.68.0",
