{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:fix": "oxlint --fix",
    "lint:check": "oxlint",
    "format:fix": "oxfmt",
    "format:check": "oxfmt --check",
    "validate:fix": "npm run format:fix && npm run lint:fix && npm run type-check",
    "validate:check": "npm run format:check && npm run lint:check && npm run type-check && npm run knip:check",
    "open-api:generate-client": "orval --config ./orval.config.ts && node scripts/generateTextLimit.ts",
    "knip:check": "knip --treat-config-hints-as-errors",
    "knip:fix": "knip --fix"
  },
  "dependencies": {
