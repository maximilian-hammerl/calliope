{
  "tasks": {
    "db:create": "dbmate --env-file ../.env create",
    "db:up": "dbmate --env-file ../.env up",
    "db:drop": "dbmate --env-file ../.env drop",
    "db:down": "deno task db:drop",
    "db:wait": "dbmate --env-file ../.env wait",
    "migrations:migrate": "dbmate --env-file ../.env migrate",
    "migrations:up": "deno task migrations:migrate",
    "migrations:rollback": "dbmate --env-file ../.env rollback",
    "migrations:down": "deno task migrations:rollback",
    "migrations:new": "dbmate --env-file ../.env new",
    "migrations:reset": "deno task migrations:down && deno task migrations:up",
    "migrations:status": "dbmate --env-file ../.env status",
    "types:generate": "deno run --env-file=../.env --allow-sys --allow-env --allow-read --allow-write --allow-net npm:kysely-codegen",
    "test": "deno test --env-file=../.env --allow-env --allow-net --allow-read --allow-sys test/",
    "format:fix": "deno fmt",
    "format:check": "deno fmt --check",
    "lint:fix": "deno lint --fix",
    "lint:check": "deno lint",
    "type-check": "deno check .",
    "validate:fix": "deno task format:fix && deno task lint:fix && deno task type-check",
    "validate:check": "deno task format:check && deno task lint:check && deno task type-check"
  },
  "imports": {
    "kysely-codegen": "npm:kysely-codegen@0.20.0",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@types/pg": "npm:@types/pg@8.23.1",
    "pg": "npm:pg@8.23.0",
    "typescript": "npm:typescript@7.0.2"
  },
  // The full set, unlike backend/: no Kysely builders here and no German, so the five it
  // leaves out all pass.
  "compilerOptions": {
    "noErrorTruncation": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": [
        "camelcase",
        "default-param-last",
        "eqeqeq",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "guard-for-in",
        "no-await-in-loop",
        "no-eval",
        "no-external-import",
        "no-implicit-declare-namespace-export",
        "no-node-globals",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-process-global",
        "no-self-compare",
        "no-sparse-arrays",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-undef",
        "no-useless-rename",
        "prefer-ascii",
        "single-var-declarator",
        "triple-slash-reference"
      ]
    }
  },
  "fmt": {
    "exclude": ["*.md"]
  }
}
